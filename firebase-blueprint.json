{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the email app.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "User's avatar URL" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role" }
      },
      "required": ["uid", "email", "role"]
    },
    "Email": {
      "title": "Email",
      "description": "An email message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique email ID" },
        "senderId": { "type": "string", "description": "UID of the sender" },
        "senderEmail": { "type": "string", "description": "Email address of the sender" },
        "senderName": { "type": "string", "description": "Name of the sender" },
        "recipientEmail": { "type": "string", "description": "Email address of the recipient" },
        "subject": { "type": "string", "description": "Email subject" },
        "body": { "type": "string", "description": "Email body content" },
        "snippet": { "type": "string", "description": "Short snippet of the body" },
        "createdAt": { "type": "timestamp", "description": "When the email was sent" },
        "read": { "type": "boolean", "description": "Whether the email has been read by the recipient" },
        "folder": { "type": "string", "enum": ["inbox", "sent", "drafts", "trash"], "description": "Which folder this email is in (from the perspective of the owner)" },
        "ownerId": { "type": "string", "description": "UID of the user who owns this copy of the email" }
      },
      "required": ["senderId", "senderEmail", "recipientEmail", "subject", "body", "createdAt", "folder", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "/emails/{emailId}": {
      "schema": { "$ref": "#/entities/Email" },
      "description": "Emails owned by users. Each email is a separate document owned by either the sender or recipient."
    }
  }
}
